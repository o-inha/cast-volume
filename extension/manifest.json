{
  "manifest_version": 3,
  "name": "Cast Volume",
  "version": "1.1.0",
  "description": "Adjust the volume of a Google Cast receiver during a cast.",
  "key": "",
  "permissions": ["nativeMessaging", "sidePanel", "storage"],
  "side_panel": {
    "default_path": "popup.html?view=panel"
  },
  "icons": {
    "16": "icons/volume16.png",
    "32": "icons/volume32.png",
    "48": "icons/volume48.png",
    "128": "icons/volume128.png"
  },
  "action": {
    "default_title": "Cast Volume",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/volume16.png",
      "32": "icons/volume32.png"
    }
  }
}
